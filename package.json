{
  "name": "bodylife-gym-management",
  "productName": "BodyLife",
  "private": true,
  "version": "1.0.0",
  "description": "BodyLife - Gym Management & Fee Tracking System",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "package:win": "vite build && electron-builder --win nsis portable --x64",
    "package:win:portable": "vite build && electron-builder --win portable --x64",
    "package:win:installer": "vite build && electron-builder --win nsis --x64",
    "package:mac": "vite build && electron-builder --mac",
    "package:all": "vite build && electron-builder -mw"
  },
  "build": {
    "appId": "com.bodylife.gymmanagement",
    "productName": "BodyLife",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BodyLife Gym Management",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/bodylife_logo.png"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.10"
  }
}
